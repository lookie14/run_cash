rules_version = '2';

// Run Cash 보안 규칙. Firebase 콘솔 > Firestore Database > 규칙 탭에 붙여넣고 게시한다.
//
// 구조
//   families/{가족 ID}                    adminUids = 관리자 목록, grandmaUid = 사용자
//   families/{가족 ID}/daily/{날짜}       걸음 수 (사용자 폰만 쓰고, 모두 읽는다)
//   families/{가족 ID}/settlements/{연-월} 월말 정산 (관리자가 쓰고, 모두 읽는다)
//   pairCodes/{6자리 코드}                사용자 연결 / 관리자 초대용 임시 코드 (10분 유효)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function familyDoc(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId));
    }

    function isAdmin(familyId) {
      return signedIn() && request.auth.uid in familyDoc(familyId).data.adminUids;
    }

    function isUser(familyId) {
      return signedIn() && familyDoc(familyId).data.grandmaUid == request.auth.uid;
    }

    function codeDoc(code) {
      return get(/databases/$(database)/documents/pairCodes/$(code));
    }

    // 가족 ID, 종류가 맞고 아직 유효한 코드인지
    function validCode(code, familyId, kind) {
      return code is string
        && exists(/databases/$(database)/documents/pairCodes/$(code))
        && codeDoc(code).data.familyId == familyId
        && codeDoc(code).data.kind == kind
        && codeDoc(code).data.expiresAt > request.time;
    }

    // ---- 연결 / 초대 코드 ----
    match /pairCodes/{code} {
      // 코드를 아는 사람만 문서 하나를 읽을 수 있다. 목록 조회(list)는 막혀 있다.
      allow get: if signedIn();

      // 관리자만 자기 가족 앞으로, 최대 15분 유효한 코드를 만들 수 있다. 이미 있는 코드는 덮어쓸 수 없다.
      allow create: if signedIn()
        && code.matches('[0-9]{6}')
        && request.resource.data.keys().hasOnly(['familyId', 'kind', 'expiresAt'])
        && request.resource.data.kind in ['user', 'admin']
        && isAdmin(request.resource.data.familyId)
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(15, 'm');

      allow update: if false;
      allow delete: if isAdmin(resource.data.familyId);
    }

    // ---- 가족 ----
    match /families/{familyId} {
      allow read: if signedIn()
        && (request.auth.uid in resource.data.adminUids || resource.data.grandmaUid == request.auth.uid);

      // 새 가족: 만든 사람이 유일한 첫 관리자
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['adminUids', 'admins', 'grandmaUid', 'createdAt'])
        && request.resource.data.adminUids == [request.auth.uid]
        && request.resource.data.admins.keys().hasOnly([request.auth.uid])
        && request.resource.data.grandmaUid == null;

      // 관리자: 무엇이든 바꿀 수 있지만 관리자가 0명이 되면 안 된다.
      allow update: if signedIn()
        && request.auth.uid in resource.data.adminUids
        && request.resource.data.adminUids is list
        && request.resource.data.adminUids.size() >= 1;

      // 새 관리자: 유효한 관리자 초대 코드로 나를 목록 끝에 추가
      allow update: if signedIn()
        && !(request.auth.uid in resource.data.adminUids)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminUids', 'admins', 'lastJoinCode'])
        && request.resource.data.adminUids == resource.data.adminUids.concat([request.auth.uid])
        && request.resource.data.admins.diff(resource.data.admins).affectedKeys().hasOnly([request.auth.uid])
        && validCode(request.resource.data.lastJoinCode, familyId, 'admin');

      // 사용자: 아직 비어 있는 가족에 유효한 사용자 연결 코드로 내 uid를 등록
      allow update: if signedIn()
        && resource.data.grandmaUid == null
        && request.resource.data.grandmaUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['grandmaUid', 'claimCode'])
        && validCode(request.resource.data.claimCode, familyId, 'user');

      allow delete: if signedIn() && request.auth.uid in resource.data.adminUids;

      // ---- 날짜별 걸음 수 ----
      match /daily/{day} {
        allow read: if isAdmin(familyId) || isUser(familyId);

        allow create, update: if isUser(familyId)
          && day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.keys().hasOnly(['steps', 'updatedAt'])
          && request.resource.data.steps is int
          && request.resource.data.steps >= 0
          && request.resource.data.steps <= 200000;

        allow delete: if false;
      }

      // ---- 월말 정산 기록 (관리자가 "보냈어요"를 누르면 생김) ----
      match /settlements/{month} {
        allow read: if isAdmin(familyId) || isUser(familyId);

        allow create, update: if isAdmin(familyId)
          && month.matches('[0-9]{4}-[0-9]{2}')
          && request.resource.data.keys().hasOnly(['amount', 'steps', 'goalDays', 'paidBy', 'paidAt'])
          && request.resource.data.amount is int
          && request.resource.data.amount >= 0;

        allow delete: if isAdmin(familyId);
      }
    }
  }
}
