rules_version = '2';

// Run Cash 보안 규칙. Firebase 콘솔 > Firestore Database > 규칙 탭에 붙여넣고 게시한다.
//
// 구조
//   families/{손주 uid}               손주 = 문서 ID와 같은 uid, 할머니 = grandmaUid
//   families/{손주 uid}/daily/{날짜}  걸음 수 (할머니 폰만 쓰고, 둘 다 읽는다)
//   pairCodes/{6자리 코드}            연결용 임시 코드 (10분 유효)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // 문서 ID(familyId)가 손주의 uid다.
    function isGrandson(familyId) {
      return signedIn() && request.auth.uid == familyId;
    }

    function isGrandma(familyId) {
      return signedIn()
        && get(/databases/$(database)/documents/families/$(familyId)).data.grandmaUid == request.auth.uid;
    }

    // ---- 연결 코드 ----
    match /pairCodes/{code} {
      // 코드를 아는 사람만 문서 하나를 읽을 수 있다. 목록 조회(list)는 막혀 있다.
      allow get: if signedIn();

      // 손주가 자기 가족 앞으로만, 최대 15분 유효한 코드를 만들 수 있다. 이미 있는 코드는 덮어쓸 수 없다.
      allow create: if signedIn()
        && code.matches('[0-9]{6}')
        && request.resource.data.keys().hasOnly(['familyId', 'expiresAt'])
        && request.resource.data.familyId == request.auth.uid
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(15, 'm');

      allow update: if false;
      allow delete: if signedIn() && resource.data.familyId == request.auth.uid;
    }

    // ---- 가족 ----
    match /families/{familyId} {
      allow read: if isGrandson(familyId)
        || (signedIn() && resource.data.grandmaUid == request.auth.uid);

      allow create: if isGrandson(familyId)
        && request.resource.data.grandsonUid == request.auth.uid
        && request.resource.data.grandmaUid == null;

      // 손주: 설정 변경, 연결 끊기(grandmaUid를 null로)
      allow update: if isGrandson(familyId)
        && request.resource.data.grandsonUid == resource.data.grandsonUid;

      // 할머니: 아직 비어 있는 가족에 유효한 연결 코드로 내 uid를 등록
      allow update: if signedIn()
        && resource.data.grandmaUid == null
        && request.resource.data.grandmaUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['grandmaUid', 'claimCode'])
        && request.resource.data.claimCode is string
        && exists(/databases/$(database)/documents/pairCodes/$(request.resource.data.claimCode))
        && get(/databases/$(database)/documents/pairCodes/$(request.resource.data.claimCode)).data.familyId == familyId
        && get(/databases/$(database)/documents/pairCodes/$(request.resource.data.claimCode)).data.expiresAt > request.time;

      allow delete: if isGrandson(familyId);

      // ---- 날짜별 걸음 수 ----
      match /daily/{day} {
        allow read: if isGrandson(familyId) || isGrandma(familyId);

        allow create, update: if isGrandma(familyId)
          && day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.keys().hasOnly(['steps', 'updatedAt'])
          && request.resource.data.steps is int
          && request.resource.data.steps >= 0
          && request.resource.data.steps <= 200000;

        allow delete: if false;
      }
    }
  }
}
